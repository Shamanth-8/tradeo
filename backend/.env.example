# =====================================================================
# Tradeo configuration — copy to backend/.env and edit.
#
#   cp backend/.env.example backend/.env
#
# Everything works with NO keys: local AI (Ollama), free market data
# (Yahoo Finance + NSE + news RSS) and paper trading. Every key below is
# optional. Keys can also be entered in the app (Connections screen); those
# are saved to config/credentials.json. Never commit .env or that file.
# =====================================================================

# ---- App -------------------------------------------------------------
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ASSISTANT_NAME=Tradeo
# How the assistant addresses you
USER_TITLE=Boss

# ---- Local AI (Ollama) — the default, nothing leaves your machine ----
# Install: https://ollama.com   then:  ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# A second, faster model for quick answers (optional; defaults to OLLAMA_MODEL)
OLLAMA_FAST_MODEL=qwen2.5:3b
# Model the research agent uses when no cloud key is set (needs tool calling)
RESEARCH_LOCAL_MODEL=qwen2.5:3b
# Free RAM between questions: the model unloads this long after the last
# answer ("0" = immediately, "30m" = keep it hot for speed)
OLLAMA_KEEP_ALIVE=2m

# local_only (default) | hybrid | local_first | cloud_first | cloud_only
#   local_only: every answer comes from Ollama; no cloud call is ever made
#   hybrid:     heavier tasks (chat, analysis, sentiment) prefer the cloud model
AI_MODE=local_only
AI_TIMEOUT_SECONDS=120
AI_CACHE_TTL_SECONDS=300
AI_TEMPERATURE=0.3

# ---- Optional cloud model ---------------------------------------------
# Used by the research agent whenever a key is set (small local models
# can't drive it), and by the rest of the app only if AI_MODE isn't local_only.
# openrouter | openai | custom
CLOUD_LLM_PROVIDER=openrouter
# Decisions stay local; the cloud model only double-checks: Watchtower candidates the
# local AI is unsure about, and every agent buy that has stock-specific news.
VERIFY_WITH_CLOUD=false
# Free key at https://openrouter.ai/keys — ":free" models cost nothing
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Or OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Or any OpenAI-compatible endpoint (CLOUD_LLM_PROVIDER=custom)
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# ---- Voice (fully local) ------------------------------------------------
VOICE_ENABLED=true
# local = Whisper on this machine | browser = the browser's recogniser
VOICE_STT=local
WHISPER_MODEL=base.en
# piper = local neural voice | browser = the browser's speech
VOICE_TTS=piper
PIPER_VOICE=en_GB-alan-medium
# jarvis = slower + light metallic/room effect | plain
VOICE_STYLE=jarvis
# Voice models load on the first mic click and unload after this many idle seconds
VOICE_IDLE_SECONDS=300

# ---- Scanner / Watchtower -------------------------------------------------
SCANNER_ENABLED=true

SCAN_INTERVAL_MINUTES=30
SCAN_UNIVERSE_LIMIT=40
SCAN_OFF_HOURS=false
ALERT_MIN_CONVICTION=65
MORNING_BRIEF=true
CLOSING_BRIEF=true

# ---- Paper trading / autopilot ------------------------------------------
# paper (default) | approval | live
AUTOPILOT_MODE=paper
# Live orders go to this broker (angelone | zerodha | dhan | kotak | a plugin name).
# Needs AUTOPILOT_MODE=live AND that broker's *_ALLOW_TRADING=true. Empty = never live.
LIVE_BROKER=
AUTO_TRIGGER_ENABLED=true

# ---- Telegram alerts (optional) ---------------------------------------------
# Create a bot with @BotFather, paste the token, then send the bot one message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING=true

# ---- Extra data (optional) -----------------------------------------------------
# Finnhub (free): IPO and earnings calendars on the Learn screen
FINNHUB_API_KEY=

# =====================================================================
# Brokers — ALL OPTIONAL. Without one, Tradeo paper trades on Yahoo
# Finance prices. Connecting one adds your real holdings to the Wealth
# screen; live orders need that broker's *_ALLOW_TRADING=true as well.
# Other brokers: add a plugin, see backend/brokers/plugins/README.md
# =====================================================================

# ---- Zerodha (Kite Connect, paid API) — https://developers.kite.trade
# Redirect URL for your Kite app: http://localhost:8000/api/setup/brokers/zerodha/callback
# Daily login: open http://localhost:8000/api/setup/brokers/zerodha/login
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_ALLOW_TRADING=false

# ---- Dhan — https://dhanhq.co (token from web.dhan.co > My Profile > DhanHQ APIs)
# Either paste a 24h access token, or give PIN + TOTP secret to auto-renew it.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_ALLOW_TRADING=false

# ---- Angel One (SmartAPI, free) — https://smartapi.angelbroking.com
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_MPIN=
# base32 secret shown when you enable TOTP
ANGELONE_TOTP_SECRET=
ANGELONE_ALLOW_TRADING=false

# ---- Kotak Neo (Trade API) — needs: pip install -r requirements-brokers.txt
KOTAK_CONSUMER_KEY=
# with country code, e.g. +919999999999
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_TOTP_SECRET=
KOTAK_MPIN=
KOTAK_ALLOW_TRADING=false
